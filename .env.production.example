# 🚀 VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO
# Copie este arquivo para .env.production e preencha os valores reais

# ================================
# 🔧 CONFIGURAÇÕES BÁSICAS
# ================================
NODE_ENV=production
PORT=3000

# ================================
# 🗄️ SUPABASE (Banco de Dados)
# ================================
SUPABASE_URL=https://njdmpdpglpidamparwtr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui
SUPABASE_ANON_KEY=sua_anon_key_aqui

# ================================
# 🔐 SEGURANÇA
# ================================
JWT_SECRET=seu_jwt_secret_super_forte_e_longo_aqui_min_32_chars

# ================================
# 🌐 URLS DE PRODUÇÃO
# ================================
FRONTEND_URL=https://gl-garantias.vercel.app
PRODUCTION_URL=https://gl-garantias-production.up.railway.app

# ================================
# 🔴 REDIS CACHE (Opcional - Upstash)
# ================================
REDIS_URL=redis://default:senha@sua-url.upstash.io:porta
UPSTASH_REDIS_URL=redis://default:senha@sua-url.upstash.io:porta

# ================================
# 📧 EMAIL (Futuro - SendGrid/Mailgun)
# ================================
# SENDGRID_API_KEY=sua_api_key_aqui
# MAILGUN_API_KEY=sua_api_key_aqui

# ================================
# 🤖 IA SERVICES (Já configuradas)
# ================================
# OPENAI_API_KEY=sk-proj-sua_key_aqui
# GROQ_API_KEY=gsk_sua_key_aqui

# ================================
# 📊 MONITORAMENTO (Opcional)
# ================================
# SENTRY_DSN=https://sua-url@sentry.io/projeto
# MIXPANEL_TOKEN=seu_token_aqui

# ================================
# 🔧 CONFIGURAÇÕES AVANÇADAS
# ================================
# RATE_LIMIT_MAX=100
# CACHE_TTL=300
# BACKUP_RETENTION_DAYS=30
# LOG_LEVEL=info

# ================================
# 📁 STORAGE (Futuro - AWS S3/Cloudinary)
# ================================
# AWS_ACCESS_KEY_ID=sua_access_key
# AWS_SECRET_ACCESS_KEY=sua_secret_key
# AWS_S3_BUCKET=gl-garantias-uploads
# AWS_REGION=us-east-1

# ================================
# 🚨 IMPORTANTE
# ================================
# 1. NUNCA commite este arquivo com valores reais
# 2. Use valores diferentes em produção vs desenvolvimento
# 3. JWT_SECRET deve ter pelo menos 32 caracteres
# 4. Mantenha as chaves do Supabase seguras
# 5. URLs devem terminar SEM barra (/)

# ================================
# 📝 EXEMPLO DE VALORES SEGUROS
# ================================
# JWT_SECRET=gl_garantias_jwt_super_secreto_2025_producao_segura_12345
# FRONTEND_URL=https://meu-sistema.vercel.app
# PRODUCTION_URL=https://meu-backend.railway.app